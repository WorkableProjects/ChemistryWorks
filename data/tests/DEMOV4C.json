      "tolerance": 2,
      "toleranceType": "percent",
      "factors": [{ "top": { "value": 1, "unit": "mol" }, "bottom": { "value": 58.44, "unit": "g" } }],
      "variables": { "m": { "min": 50, "max": 250, "step": 10 } },
      "givenVariable": "m",
      "answerFormula": "= m / molarMass(\"NaCl\")",
