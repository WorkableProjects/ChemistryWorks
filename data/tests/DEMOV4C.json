    {
      "id": "q5",
      "type": "estimate",
      "text": "Estimate the pH of 0.010 M hydrochloric acid.",
      "points": 1,
      "min": 0,
      "max": 14,
      "step": 0.5,
      "answer": 2,
      "tolerance": 0.5,
      "toleranceType": "absolute",
      "explanation": "HCl is a strong acid: pH = -log(0.010) = 2."
    },
    {
      "id": "q6",
      "type": "numeric",
      "text": "How many moles are in {m} g of $\\ce{{compound}}$?",
      "points": 2,
      "correctAnswer": 0.5,
      "tolerance": 2,
      "toleranceType": "percent",
      "unit": "mol",
      "variables": {
        "m": { "min": 10, "max": 100, "step": 5, "sigFigs": 3 },
        "compound": { "pick": ["NaCl", "KCl", "CaCl2"] }
      },
      "answerFormula": "= m / molarMass(compound)",
      "explanation": "moles = mass / molar mass."
    },
    {
      "id": "q7",
      "type": "sigfigs",
      "text": "A gas sample at {T} K and 1.00 atm occupies {V} L. How many moles of gas is that? Give 3 significant figures.",
      "points": 2,
      "answer": 0.0409,
      "sigFigs": 3,
      "tolerance": 0.001,
      "partialCredit": true,
      "variables": {
        "T": { "min": 250, "max": 350, "step": 10, "sigFigs": 3 },
        "V": { "min": 1, "max": 5, "step": 0.5, "sigFigs": 2 }
      },
      "answerFormula": "= idealGasN(1, V, T)",
      "explanation": "n = PV / RT with R = 0.08206 L atm / (mol K)."
    },
    {
      "id": "q8",
      "type": "dimensional",
      "text": "Convert {m} g of sodium chloride to moles.",
