      "ask": "both",
      "volumeTolerance": 0.5,
      "phTolerance": 0.3,
      "partialCredit": true,
      "explanation": "Equal moles of acid and base: 25.0 mL. The acetate ion is a weak base, so the pH is above 7 (about 8.72)."
