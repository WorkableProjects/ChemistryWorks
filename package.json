{
  "name": "chemistryworks",
  "version": "5.0.1",
  "private": true,
  "description": "ChemistryWorks — serverless chemistry testing platform (static HTML on GitHub Pages + Google Apps Script).",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "build:catalog": "node scripts/build-catalog.mjs",
    "validate:tests": "node scripts/validate-tests.mjs",
    "gas:push": "cd apps-script && clasp push"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "axe-core": "4.10.3"
  }
}
